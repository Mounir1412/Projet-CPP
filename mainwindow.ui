         </property>
         <property name="styleSheet">
          <string notr="true">/* 🌟 QGroupBox fond presque blanc avec bleu et gris très subtil */
QGroupBox {
    background: qlineargradient(
        x1:0, y1:0, x2:0, y2:1,
        stop:0 #F8FAFC,   /* blanc avec un peu de gris */
        stop:1 #EFF5FA    /* bleu très très pâle + gris léger */
    );
    border: 2px solid #D1D9E6;  /* gris très clair pour la bordure */
    border-radius: 16px;
    margin-top: 22px;
    padding-top: 30px;
    font-weight: 600;
    font-size: 14px;
    color: #032242;
}

/* Effet de relief */
QGroupBox {
    border-bottom: 3px solid #C0C8D8; /* gris très clair pour le relief */
}

/* 🔵 Titre = couleur de référence #3b82f6 */
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 7px 20px;
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #3b82f6,
        stop:0.5 #5a95f8,
        stop:1 #3b82f6
    );
    color: #ffffff; /* texte blanc pour contraste */
    border: 2px solid #3b82f6;
    border-radius: 10px;
    margin-left: 16px;
    font-weight: 700;
    letter-spacing: 0.7px;
}

/* 🔹 Bouton statistique avec la même couleur de référence */
QPushButton#statButton {
    background-color: #3b82f6;
    color: white;
    border-radius: 8px;
    padding: 6px 12px;
    font-weight: 600;
}
QPushButton#statButton:hover {
    background-color: #60a0f8;
}
QPushButton#statButton:pressed {
    background-color: #2565d6;
}


</string>
